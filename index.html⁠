<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>¡Flores Amarillas para Ti! 🌻</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: linear-gradient(135deg, #fffde7 0%, #fff59d 100%);
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
      text-align: center;
    }

    h1 {
      color: #f57f17;
      font-size: 2rem;
      margin-bottom: 10px;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
      animation: pulse 2s infinite ease-in-out;
      padding: 0 15px;
    }

    p {
      color: #fbc02d;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 30px;
      padding: 0 15px;
    }

    .bouquet-container {
      position: relative;
      width: 220px;
      height: 280px;
      animation: float 3s infinite ease-in-out;
    }

    .flower {
      position: absolute;
      width: 80px;
      height: 80px;
      background: #fbc02d;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .flower::before {
      content: '';
      position: absolute;
      width: 45px;
      height: 45px;
      background: #5d4037;
      border-radius: 50%;
      z-index: 2;
    }

    .flower-1 { top: 20px; left: 70px; z-index: 3; animation: spin 12s linear infinite; }
    .flower-2 { top: 70px; left: 20px; transform: scale(0.85); animation: spin 15s linear infinite reverse; }
    .flower-3 { top: 70px; right: 20px; transform: scale(0.85); animation: spin 10s linear infinite; }

    .stem-group {
      position: absolute;
      bottom: 10px;
      left: 105px;
      width: 10px;
      height: 120px;
      background: #7cb342;
      border-radius: 5px;
      z-index: 1;
    }

    .bow {
      position: absolute;
      bottom: 50px;
      left: 85px;
      font-size: 40px;
      z-index: 4;
      animation: wiggle 2s infinite ease-in-out;
    }

    .petal {
      position: absolute;
      background-color: #fff176;
      border-radius: 15px 0 15px 0;
      opacity: 0.8;
      pointer-events: none;
      animation: fall linear infinite;
    }

    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
    }

    @keyframes wiggle {
      0%, 100% { transform: rotate(-5deg); }
      50% { transform: rotate(5deg); }
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    @keyframes fall {
      0% {
        top: -10%;
        transform: translateX(0) rotate(0deg);
        opacity: 1;
      }
      100% {
        top: 105%;
        transform: translateX(100px) rotate(360deg);
        opacity: 0;
      }
    }
  </style>
</head>
<body>

  <h1>✨ Para ti mi bella flaca ✨</h1>
  <p>💛 Flores amarillas llenas de luz y alegría 💛</p>

  <div class="bouquet-container">
    <div class="flower flower-1"></div>
    <div class="flower flower-2"></div>
    <div class="flower flower-3"></div>
    <div class="stem-group"></div>
    <div class="bow">🎀</div>
  </div>

  <script>
    function createPetal() {
      const petal = document.createElement('div');
      petal.classList.add('petal');
      
      const size = Math.random() * 15 + 10;
      petal.style.width = `${size}px`;
      petal.style.height = `${size}px`;
      
      petal.style.left = Math.random() * 100 + 'vw';
      petal.style.animationDuration = Math.random() * 3 + 2 + 's';
      
      document.body.appendChild(petal);

      setTimeout(() => {
        petal.remove();
      }, 5000);
    }

    setInterval(createPetal, 300);
  </script>
</body>
</html>
